# Секреты не передаются в Docker Compose. Добавьте их как credentials в n8n:
# 1. Ollama API: http://host.docker.internal:11434 (macOS, recommended)
#    Fallback: http://ollama:11434 (fully containerized)
# 2. HTTP Bearer Auth: GitHub fine-grained PAT только для чтения

N8N_URL=http://localhost:5678
